PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# Replace with a unique random value of at least 32 characters.
JWT_SECRET=140a39d79248bbb040aa1a29aae8d2531659669b628ba2fc65c8a06327df58f2e8bf3d2016657c5cebd82c803c9c60afe2dc392a0344914bd45a22c0cc60295e
JWT_EXPIRES_IN=7d
AUTH_COOKIE_DAYS=7
# Keep false when the client is served by Express. Enable only for a separately
# hosted development client that must use an Authorization header.
AUTH_RETURN_TOKEN=false

# Comma-separated browser origins allowed by CORS.
CLIENT_URL=http://localhost:5000,http://127.0.0.1:5500
CLIENT_APP_URL=http://localhost:5000
SERVER_URL=http://localhost:5000

# Store pricing
FREE_SHIPPING_THRESHOLD=5000
FLAT_SHIPPING_FEE=120

# SSLCOMMERZ hosted checkout. Create sandbox credentials at
# https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Admin created by npm run seed. Change this password before sharing a server.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
